# Local development works without credentials.
CBS_MODE=synthetic
# Temporarily true for password-only hosted testing. Restore false to require email/MFA.
CBS_TESTING_MODE=true
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
CBS_DB_PATH=.data/cbs.sqlite

# Fill only when connecting Appwrite. Never prefix secrets with VITE_.
# CBS_MODE=appwrite
# APPWRITE_ENDPOINT=https://appwrite.diplomat-server.base44-ng.online/v1
# APPWRITE_PROJECT_ID=6aec6c54003e61828de5
# Runtime-only credential. Populate at deployment with rows.read, rows.write,
# files.read and files.write. Provisioning credentials are separate.
# APPWRITE_API_KEY=
# For scripts/database.ts migrate or seed only. Supply in the operator shell.
# APPWRITE_PROVISIONING_KEY=
# APPWRITE_DATABASE_ID=cbs
# APPWRITE_DATA_KEY=
# APPWRITE_EVIDENCE_BUCKET_ID=cbs_evidence
# CBS_CLAMAV_HOST=clamav
# CBS_CLAMAV_PORT=3310
# CBS_REMINDER_INTERVAL_MS=900000
# Generate the data key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
